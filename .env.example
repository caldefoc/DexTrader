# Copy to .env and fill in what you have. Every key is optional:
# market data falls back to keyless endpoints, and signals fall back to a
# deterministic rule when no LLM key is present.

# Market data (free tiers; leave blank to use anonymous limits)
COINMARKETCAP_API_KEY=
COINGECKO_API_KEY=

# Signal generation (first match wins: DeepSeek, then OpenAI, then the rule)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Frontend build-time backend origin (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Public demo: virtual portfolio, live market data, no wallet, no real trades.
# Set to 1 on the demo host only.
DEMO_MODE=0
# Corresponding frontend flag: shows the demo banner and hides wallet UI.
NEXT_PUBLIC_DEMO_MODE=0

# Backend CORS origins (comma separated). Defaults to localhost:3000.
# CORS_ORIGINS=https://dextrader.caldefoc.com

# Base JSON-RPC used for the live gas-price check
# BASE_RPC_URL=https://mainnet.base.org

# Directory for agent_state.json / price_history.json / demo_portfolio.json
# DEXTRADER_STATE_DIR=
